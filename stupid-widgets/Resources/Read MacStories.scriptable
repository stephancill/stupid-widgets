{
  "name": "Read MacStories",
  "icon": { "color": "red", "glyph": "newspaper" },
  "script": "// Shows articles from MacStories. Works in the app, as a widget or via Shortcuts.\nlet items = await loadItems()\nif (config.runsInWidget) {\n  let widget = await createWidget(items)\n  Script.setWidget(widget)\n} else if (config.runsWithSiri) {\n  let firstItems = items.slice(0, 5)\n  let table = createTable(firstItems)\n  await QuickLook.present(table)\n} else {\n  let table = createTable(items)\n  await QuickLook.present(table)\n}\nScript.complete()\n\nasync function createWidget(items) {\n  let item = items[0]\n  let authors = item.authors.map(a => a.name).join(\", \")\n  let widget = new ListWidget()\n  widget.backgroundColor = new Color(\"#b00a0f\")\n  let gradient = new LinearGradient()\n  gradient.locations = [0, 1]\n  gradient.colors = [new Color(\"#b00a0fe6\"), new Color(\"#b00a0fb3\")]\n  widget.backgroundGradient = gradient\n  widget.addSpacer()\n  let title = widget.addText(item.title)\n  title.font = Font.boldSystemFont(16)\n  title.textColor = Color.white()\n  title.minimumScaleFactor = 0.75\n  widget.addSpacer(8)\n  let footer = widget.addStack()\n  let authorsEl = footer.addText(authors)\n  authorsEl.font = Font.mediumSystemFont(12)\n  authorsEl.textColor = Color.white()\n  authorsEl.textOpacity = 0.9\n  footer.addSpacer()\n  widget.addSpacer()\n  widget.url = item.url\n  return widget\n}\n\nfunction createTable(items) {\n  let table = new UITable()\n  for (let i = 0; i < items.length; i++) {\n    let item = items[i]\n    let row = new UITableRow()\n    let titleCell = row.addText(item.title)\n    titleCell.widthWeight = 100\n    row.height = 60\n    row.onSelect = (idx) => {\n      Safari.open(items[idx].url)\n    }\n    row.dismissOnSelect = false\n    table.addRow(row)\n  }\n  return table\n}\n\nasync function loadItems() {\n  let url = \"https://macstories.net/feed/json\"\n  let req = new Request(url)\n  let json = await req.loadJSON()\n  return json.items\n}\n",
  "always_run_in_app": false,
  "share_sheet_inputs": []
}
